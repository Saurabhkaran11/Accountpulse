# AccountPulse agent API settings.
# 1. Copy to .env   2. Fill keys in the order below   3. Run: python check_keys.py
# Any key left empty keeps that step on sample data.

# Start in MOCK mode (sample data). Set to false once check_keys.py passes.
MOCK=true

# Web app address(es) allowed to call this API (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000

# 1. Crusoe - REQUIRED for the overall prize (main AI model)
#    Crusoe console > Intelligence Foundry > Get API key
CRUSOE_API_KEY=
CRUSOE_BASE_URL=https://api.inference.crusoecloud.com/v1
CRUSOE_MODEL=meta-llama/Llama-3.3-70B-Instruct
# No Crusoe key yet? Your OpenRouter key runs this model on Crusoe GPUs instead
# (pinned to Crusoe, no fallback). Alternative: moonshotai/kimi-k2.6
CRUSOE_VIA_OPENROUTER_MODEL=z-ai/glm-5.3

# 2. Neo4j AuraDB Free - https://console.neo4j.io (download the credentials file)
NEO4J_URI=neo4j+s://xxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# 3. OpenRouter -> Nebius (critic model) - https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Verified on Nebius (DuploCloud hackday guide); alternative: qwen/qwen3-235b-a22b-2507
CRITIC_MODEL=z-ai/glm-5.1
#    Optional: call Nebius directly - https://tokenfactory.nebius.com
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# 4. Brave Search - https://api-dashboard.search.brave.com
BRAVE_API_KEY=

# 5. Merge.dev - https://app.merge.dev (API key + a linked sandbox CRM's account token)
MERGE_API_KEY=
MERGE_ACCOUNT_TOKEN=
DEFAULT_COMPETITOR=rivalsaas.com

# 6. Similarweb - from the sponsor desk
SIMILARWEB_API_KEY=

# 7. Vultr (hosting) - add a payment method, then account name > Manage User >
#    Access > API Access > Enable; add your IP to Access Control
VULTR_API_KEY=

# 8. DuploCloud DevKit - runs locally in Docker, no key (see docs/DUPLOCLOUD.md)
DUPLO_UI_URL=http://localhost:4210
DUPLO_STUDIO_URL=http://localhost:60031

# 9. UserTesting (feedback) - from the sponsor desk; test id of a test you created
USERTESTING_TOKEN=
USERTESTING_TEST_ID=
