# URL of the AccountPulse agent API (the FastAPI app from the backend starter).
# Leave empty to run the UI on built-in demo data.
NEXT_PUBLIC_API_URL=

# SEC EDGAR (free, no key) requires a User-Agent with your contact email.
SEC_USER_AGENT="AccountPulse your-email@yourcompany.com"

# Optional, server-side only: lets Crusoe write the Live check explanation.
CRUSOE_API_KEY=
CRUSOE_MODEL=meta-llama/Llama-3.3-70B-Instruct
